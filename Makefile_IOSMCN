PROJECT_NAME := upf-epc
VERSION ?= $(shell cat ./VERSION 2>/dev/null || echo dev)

# Build configuration
NPROCS := $(shell nproc)
CPU ?= native

# Docker configuration
DOCKER_REGISTRY ?=
DOCKER_REPOSITORY ?=
DOCKER_TAG ?= $(VERSION)
DOCKERFILE ?= Dockerfile

DOCKER_TARGETS ?= bess pfcp
DOCKER_PULL ?= --pull

# Preserve the existing IOSMCN image naming convention:
# <registry><repository>/upf-epc-bess:<tag>
# <registry><repository>/upf-epc-pfcp:<tag>

DOCKER_BUILD_ARGS ?= \
	--build-arg MAKEFLAGS=-j$(NPROCS) \
	--build-arg CPU=$(CPU)

# IOSMCN source repository
VCS_URL := https://github.com/ios-mcn-core/upf
VCS_REF ?= $(shell git rev-parse HEAD 2>/dev/null || echo unknown)
BUILD_DATE ?= $(shell date -u +'%Y-%m-%dT%H:%M:%SZ')

DOCKER_METADATA_ARGS = \
	--build-arg VERSION=$(VERSION) \
	--build-arg VCS_URL=$(VCS_URL) \
	--build-arg VCS_REF=$(VCS_REF) \
	--build-arg BUILD_DATE=$(BUILD_DATE)

DOCKER_IMAGE_PREFIX = $(DOCKER_REGISTRY)$(DOCKER_REPOSITORY)$(PROJECT_NAME)

.PHONY: all docker-build docker-push docker-clean output pb py-pb

all: docker-build

# Build the requested Docker targets
docker-build:
	@set -e; \
	for target in $(DOCKER_TARGETS); do \
		image="$(DOCKER_IMAGE_PREFIX)-$$target:$(DOCKER_TAG)"; \
		echo "Building IOSMCN image: $$image"; \
		docker build $(DOCKER_PULL) \
			$(DOCKER_BUILD_ARGS) \
			$(DOCKER_METADATA_ARGS) \
			-f $(DOCKERFILE) \
			--target $$target \
			-t $$image .; \
	done

# Push the requested Docker targets
docker-push:
	@set -e; \
	for target in $(DOCKER_TARGETS); do \
		image="$(DOCKER_IMAGE_PREFIX)-$$target:$(DOCKER_TAG)"; \
		echo "Pushing IOSMCN image: $$image"; \
		docker push $$image; \
	done

# Remove locally built images
docker-clean:
	@set -e; \
	for target in $(DOCKER_TARGETS); do \
		image="$(DOCKER_IMAGE_PREFIX)-$$target:$(DOCKER_TAG)"; \
		docker image rm -f $$image 2>/dev/null || true; \
	done

# Export build artifacts
output:
	docker build $(DOCKER_PULL) \
		$(DOCKER_BUILD_ARGS) \
		$(DOCKER_METADATA_ARGS) \
		-f $(DOCKERFILE) \
		--target artifacts \
		--output type=local,dest=./output .

# Export Go protobuf files
pb:
	docker build $(DOCKER_PULL) \
		$(DOCKER_BUILD_ARGS) \
		-f $(DOCKERFILE) \
		--target pb \
		--output type=local,dest=./pb .

# Export Python protobuf files
py-pb:
	docker build $(DOCKER_PULL) \
		$(DOCKER_BUILD_ARGS) \
		-f $(DOCKERFILE) \
		--target ptf-pb \
		--output type=local,dest=./py-pb .